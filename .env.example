# CompIT 2026 rCTF Environment Variables Template
# Copy this file to .env and change values accordingly

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=rctf

# Database Connection
RCTF_DATABASE_HOST=compit-postgres
RCTF_DATABASE_PORT=5432
RCTF_DATABASE_USERNAME=postgres
RCTF_DATABASE_PASSWORD=change_this_to_a_secure_password
RCTF_DATABASE_DATABASE=rctf

# Redis Cache & Queue
RCTF_REDIS_HOST=compit-redis
RCTF_REDIS_PORT=6379
RCTF_REDIS_PASSWORD=change_this_to_a_secure_password

# Secret Token Key (Generate with: openssl rand -base64 32)
RCTF_TOKEN_KEY=generate_random_base64_key_here

# Public Origin (Domain)
RCTF_ORIGIN=https://ctf.compit.its.ac.id
