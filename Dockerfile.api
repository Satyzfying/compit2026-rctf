FROM oven/bun:1.3.14-debian AS builder

WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY apps/ ./apps/
COPY packages/ ./packages/
COPY rctf.d/ ./rctf.d/

RUN bun install --frozen-lockfile
RUN bun run build:api

FROM oven/bun:1.3.14-debian AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV WORKER_EXTENSION=.js

COPY --from=builder /app/rctf.d ./rctf.d
COPY --from=builder /app/packages/db/migrations ./packages/db/migrations
COPY --from=builder /app/apps/api/templates ./apps/api/templates
COPY --from=builder /app/apps/api/templates ./templates
COPY --from=builder /app/apps/api/dist ./dist

# Install runtime dependencies needed by native modules (sharp)
COPY --from=builder /app/apps/api/dist/runtime-package.json ./package.json
RUN bun install --production

EXPOSE 3000

CMD ["bun", "dist/index.js"]

